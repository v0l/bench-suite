<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Bench Suite"
      Manufacturer="v0l"
      Version="$(var.Version)"
      UpgradeCode="4a01ffe0-3be6-4e3c-9e46-353e38b17570"
      Scope="perMachine"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Bench Suite is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="packaging\windows\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/v0l/bench-suite" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Bench Suite">
        <Component Id="AppExe" Guid="45d57cea-cf59-421d-9bbe-971373ef3ad8">
          <File Id="BenchSuiteExe" Source="$(var.BinDir)\bench-suite.exe" KeyPath="yes" />
        </Component>
        <Component Id="AppDocs" Guid="b31a9b03-c8d0-41a2-8ea8-ce2040823873">
          <File Id="ReadmeMd" Source="README.md" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="AppShortcut" Guid="b9cab278-eaa7-41ef-be76-84111bcbe070">
        <Shortcut Id="BenchSuiteShortcut" Icon="AppIcon" Name="Bench Suite" Target="[#BenchSuiteExe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\v0l\BenchSuite" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Bench Suite" Level="1">
      <ComponentRef Id="AppExe" />
      <ComponentRef Id="AppDocs" />
      <ComponentRef Id="AppShortcut" />
    </Feature>
  </Package>
</Wix>
